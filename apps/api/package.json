    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.11.11",
    "@types/pino-http": "^5.8.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
