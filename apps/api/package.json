{
  "name": "@copilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend REST API service for AI Job Application Copilot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
