# ==============================================================================
# API Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database — Prisma Postgres
# ------------------------------------------------------------------------------
# Obtain your connection string from the Prisma Postgres dashboard:
#   https://console.prisma.io
#
# For Prisma Postgres (cloud-managed), your DATABASE_URL looks like:
#   prisma+postgres://accelerate.prisma-data.net/?api_key=<YOUR_API_KEY>
#
# For a standard self-hosted PostgreSQL instance:
#   postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
#
# After setting this value, run:
#   npm run db:migrate --workspace=@copilot/api   # Create/apply migrations
#   npm run db:generate --workspace=@copilot/api  # Regenerate Prisma Client
DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_POSTGRES_API_KEY_HERE

# ------------------------------------------------------------------------------
# Security & Secrets (Future Phase — Auth)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_secure_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# AI Services (Future Phase)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder-openai-api-key
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key
