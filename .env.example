# ==============================================================================
# AI Job Application Copilot - Master Environment Configuration Template
# Copy this file to .env.local (for local development) or appropriate environment files.
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=localhost
API_BASE_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. NEXT.JS FRONTEND EXPOSED VARIABLES
# Note: Next.js requires the 'NEXT_PUBLIC_' prefix to expose variables to the browser.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI Job Application Copilot"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://copilot_user:copilot_password@localhost:5432/ai_job_copilot?schema=public
DATABASE_DIRECT_URL=postgresql://copilot_user:copilot_password@localhost:5432/ai_job_copilot?schema=public

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY SECRETS
# Generate secure 32+ character random strings for production keys.
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_super_secret_signing_key_min_32_characters
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=your_nextauth_session_encryption_secret
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. AI & LLM PROVIDER CREDENTIALS
# Required for resume parsing, job description analysis, and cover letter generation.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder-openai-api-key-here
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 6. STORAGE & FILE UPLOADS (Resume documents, PDFs)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=local # local | s3
AWS_ACCESS_KEY_ID=placeholder_aws_access_key
AWS_SECRET_ACCESS_KEY=placeholder_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=job-copilot-resumes

# ------------------------------------------------------------------------------
# 7. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL=debug # debug | info | warn | error
